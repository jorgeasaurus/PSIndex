# Upstream docs for this pipeline; read by pipelines/refresh.sh.
# MicrosoftDocs/entra-powershell-docs is not publicly clonable (anonymous git
# returns "repository not found", with no redirect). The cmdlet reference is
# published from the module repo, same clone form as the other sources.
REPO=https://github.com/microsoftgraph/entra-powershell.git
SPARSE=(module/docs/entra-powershell-v1.0 module/docs/entra-powershell-beta)
PARSE_DIR=module/docs
