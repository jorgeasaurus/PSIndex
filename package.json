{
  "name": "psindex",
  "version": "1.0.0",
  "description": "One searchable index of Microsoft Graph, Az, Entra, Exchange and MECM PowerShell cmdlets.",
  "scripts": {
    "index": "node scripts/build-index.mjs",
    "dev": "npm run index && astro dev",
    "build": "npm run index && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:e2e": "node tests/e2e.cjs",
    "typecheck": "npm run index && tsc --noEmit -p ."
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.13",
    "lucide-preact": "^1.78.0",
    "preact": "^11.2.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
