{
  "name": "psindex",
  "version": "1.0.0",
  "description": "One searchable index of Microsoft Graph, Az, Entra, Exchange and MECM PowerShell cmdlets.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "index": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-index.ts",
    "dev": "npm run index && astro dev",
    "build": "npm run index && astro build",
    "preview": "astro preview",
    "test:e2e": "node tests/e2e.cjs",
    "test:mcp": "node tests/mcp.cjs",
    "test:pipelines": "python3 -m unittest discover -s pipelines/tests",
    "typecheck": "tsc --noEmit -p .",
    "verify": "npm run build && npm run typecheck && playwright install --with-deps chromium && npm run test:e2e && npm run test:mcp && npm run test:pipelines"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/preact": "^6.1.6",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "astro": "^7.4.13",
    "lucide-preact": "^1.78.0",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.63.0",
    "sirv": "^3.0.2",
    "typescript": "6.0.2"
  }
}
