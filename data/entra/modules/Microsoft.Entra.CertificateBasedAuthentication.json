{"module":"Microsoft.Entra.CertificateBasedAuthentication","version":"1.3.0","cmdlets":{"Get-EntraUserCBAAuthorizationInfo":{"syntax":"Get-EntraUserCBAAuthorizationInfo\n [-UserId] <String>\n [-Raw]\n [<CommonParameters>]","examples":["Connect-Entra -Scopes 'User.Read.All'\nGet-EntraUserCBAAuthorizationInfo -UserId 'SawyerM@contoso.com'","Connect-Entra -Scopes 'User.Read.All'\n$userInfo = Get-EntraUserCBAAuthorizationInfo -UserId 'SawyerM@contoso.com'\n$userInfo.AuthorizationInfo.CertificateUserIds | Format-Table Type, TypeName, Value","Connect-Entra -Scopes 'User.Read.All'\n$userInfo = Get-EntraUserCBAAuthorizationInfo -UserId 'SawyerM@contoso.com'\n$userInfo.AuthorizationInfo.CertificateUserIds | Where-Object Type -eq \"PN\" | Select-Object -ExpandProperty Value"],"permissions":[]},"Get-EntraUserCertificateUserIdsFromCertificate":{"syntax":"Get-EntraUserCertificateUserIdsFromCertificate\n [-Path] <string>\n [[-Certificate] <System.Security.Cryptography.X509Certificates.X509Certificate2> [-CertificateMapping] <string>]\n [<CommonParameters>]","examples":["Get-EntraUserCertificateUserIdsFromCertificate -Path 'C:\\path\\to\\certificate.cer'","Get-EntraUserCertificateUserIdsFromCertificate -Path 'C:\\path\\to\\certificate.cer' -CertificateMapping 'Subject'","$text = \"-----BEGIN CERTIFICATE-----\nMIIDiz...=\n-----END CERTIFICATE-----\"\n$bytes = [System.Text.Encoding]::UTF8.GetBytes($text)\n$certificate = [System.Security.Cryptography.X509Certificates.X509Certificate2]::new($bytes)\nGet-EntraUserCertificateUserIdsFromCertificate -Certificate $certificate -CertificateMapping 'Subject'"],"permissions":[]},"Set-EntraUserCBACertificateUserId":{"syntax":"Set-EntraUserCBACertificateUserId\n -UserId <string>\n [-CertPath <string>]\n [-Cert <System.Security.Cryptography.X509Certificates.X509Certificate2>]\n -CertificateMapping <string[]>\n [<CommonParameters>]","examples":["Connect-Entra -Scopes 'Directory.ReadWrite.All', 'User.ReadWrite.All'\nSet-EntraUserCBACertificateUserI